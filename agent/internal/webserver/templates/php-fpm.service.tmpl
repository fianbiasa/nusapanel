# PHP {{.PHPVersion}} pool of one rayxo account; the instance name is the
# username, e.g. rayxo-php{{.PHPTag}}@budi.service. Written by rayxod; changes are overwritten.
[Unit]
Description=PHP {{.PHPVersion}} FastCGI pool of %i (rayxo)
After=network.target
ConditionPathExists={{.PoolDir}}/%i.conf
# The PHP of a suspended account stays stopped, also after a reboot.
ConditionPathExists=!{{.NginxDir}}/%i/suspended.inc

[Service]
Type=notify
# The account's CPU, memory, process and IO limits, when its package has
# any, are set on this slice.
Slice=rayxo-%i.slice
{{- if .CustomPHPDir}}
# The administrator's php.ini additions, after the system's.
Environment=PHP_INI_SCAN_DIR=:{{.CustomPHPDir}}
{{- end}}
ExecStart={{.Binary}} --nodaemonize --fpm-config {{.PoolDir}}/%i.conf
ExecReload=/bin/kill -USR2 $MAINPID
RuntimeDirectory={{.RuntimeDirectory}}
# Other accounts' sockets live in the same directory.
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
