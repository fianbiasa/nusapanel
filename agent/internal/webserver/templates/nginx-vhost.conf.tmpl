# {{.Domain}} of account {{.User}}. Written by rayxod; changes are overwritten.
server {
    listen 80;
{{- if .IPv6}}
    listen [::]:80;
{{- end}}
{{- template "identity" .}}

    # Let's Encrypt checks for this domain's certificate, answered from the
    # shared ACME folder, also when HTTPS is forced.
    location ^~ /.well-known/acme-challenge/ {
        root {{.AcmeDir}};
        default_type text/plain;
        try_files $uri =404;
    }
{{- if .ForceHTTPS}}

    location / {
        return 301 https://$host$request_uri;
    }
{{- else}}
{{- template "content" .}}
{{- end}}
}
{{- if .SSL}}

server {
    listen 443 ssl http2;
{{- if .IPv6}}
    listen [::]:443 ssl http2;
{{- end}}
{{- template "identity" .}}

    ssl_certificate {{.Certificate}};
    ssl_certificate_key {{.CertificateKey}};
    ssl_protocols TLSv1.2 TLSv1.3;
{{- template "content" .}}
}
{{- end}}
{{- /* What every server of the domain shares, on any port. */ -}}
{{define "identity"}}
    server_name {{.Domain}} www.{{.Domain}};

    access_log {{.LogDir}}/{{.Domain}}.access.log;
    error_log {{.LogDir}}/{{.Domain}}.error.log;

    server_tokens off;
{{- end}}
{{- /* What the domain answers with, the same over HTTP and HTTPS. */ -}}
{{define "content"}}
{{- if .ForwardTo}}
{{- template "forward" .}}
{{- else}}
{{- template "site" .}}
{{- end}}
{{- end}}
{{- /* A domain pointer that sends every visitor to its main domain. */ -}}
{{define "forward"}}
{{- template "suspended" .}}

    location / {
        return 301 $scheme://{{.ForwardTo}}$request_uri;
    }
{{- end}}
{{- /* Exists only while the account is suspended (the glob makes a missing file fine). */ -}}
{{define "suspended"}}

    include {{.NginxAccountDir}}/suspended*.inc;
{{- end}}
{{- /* Serving the website itself. */ -}}
{{define "site"}}

    root {{.DocumentRoot}};

    # Never serve a file through a symlink that someone else owns, such as a
    # link to another account's wp-config.php.
    disable_symlinks if_not_owner from=$document_root;
    client_max_body_size {{.ClientMaxBodySize}};
{{- template "suspended" .}}
{{- range .Redirects}}

    # Redirect {{.Path}}{{if .Wildcard}} and everything under it{{end}}.
    location ~ {{.Location}} {
{{- if .Wildcard}}
        if ($request_uri ~ "{{.RequestPattern}}") {
            return {{.Status}} "{{.Target}}$rayxo_rest{{.Query}}";
        }
{{- end}}
        return {{.Status}} "{{.Target}}{{.Query}}";
    }
{{- end}}

    location ~ /\.ht {
        deny all;
    }

    # Static files straight from disk. Missing ones go to Apache, so rewrites
    # in .htaccess still work.
    location ~* \.(?:css|js|mjs|map|jpg|jpeg|png|gif|webp|avif|svg|ico|bmp|woff|woff2|ttf|otf|eot|mp4|webm|ogg|mp3|wav|pdf|txt|zip|gz|tgz|rar|7z)$ {
        try_files $uri @apache;
    }

    location / {
{{- template "proxy" .}}
    }

    location @apache {
{{- template "proxy" .}}
    }
{{- end}}
{{- /* Apache behind Nginx. X-Forwarded-Proto tells Apache (and PHP) whether the visitor uses HTTPS. */ -}}
{{define "proxy"}}
        proxy_pass http://{{.Backend}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        # Room for large response headers (big cookies, Link preloads), which
        # would otherwise end in a 502.
        proxy_buffer_size 32k;
        proxy_buffers 16 16k;
        proxy_busy_buffers_size 64k;
{{- end}}
