# {{.Domain}} of account {{.User}}. Written by rayxod; changes are overwritten.
server {
{{- range .Listen}}
    listen {{.}}80;
{{- end}}
{{- template "identity" .}}

    # Let's Encrypt checks for this domain's certificate, answered from the
    # shared ACME folder, also when HTTPS is forced.
    location ^~ /.well-known/acme-challenge/ {
        root {{.AcmeDir}};
        default_type text/plain;
        try_files $uri =404;
    }
{{- if .ForceHTTPS}}

    location / {
        return 301 https://$host$request_uri;
    }
{{- else}}
{{- template "content" .}}
{{- end}}
}
{{- if .SSL}}

server {
{{- range .Listen}}
    listen {{.}}443 ssl http2;
{{- end}}
{{- template "identity" .}}

    ssl_certificate {{.Certificate}};
    ssl_certificate_key {{.CertificateKey}};
    ssl_protocols TLSv1.2 TLSv1.3;
{{- template "content" .}}
}
{{- end}}
{{- /* What every server of the domain shares, on any port. */ -}}
{{define "identity"}}
    server_name {{.Domain}} www.{{.Domain}};
{{- if eq .WWW "www"}}

    # Every visitor ends up on www.{{.Domain}}.
    if ($host = {{.Domain}}) {
        return 301 $scheme://www.{{.Domain}}$request_uri;
    }
{{- else if eq .WWW "bare"}}

    # Every visitor ends up on {{.Domain}}, without www.
    if ($host = www.{{.Domain}}) {
        return 301 $scheme://{{.Domain}}$request_uri;
    }
{{- end}}

    access_log {{.LogDir}}/{{.Domain}}.access.log;
    error_log {{.LogDir}}/{{.Domain}}.error.log;

    server_tokens off;
{{- end}}
{{- /* What the domain answers with, the same over HTTP and HTTPS. */ -}}
{{define "content"}}
{{- if .ForwardTo}}
{{- template "forward" .}}
{{- else}}
{{- template "site" .}}
{{- end}}
{{- end}}
{{- /* A domain pointer that sends every visitor to its main domain. */ -}}
{{define "forward"}}
{{- template "suspended" .}}

    location / {
        return 301 $scheme://{{.ForwardTo}}$request_uri;
    }
{{- end}}
{{- /* Exists only while the account is suspended (the glob makes a missing file fine). */ -}}
{{define "suspended"}}

    include {{.NginxAccountDir}}/suspended*.inc;
{{- end}}
{{- /* Serving the website itself. */ -}}
{{define "site"}}

    root {{.DocumentRoot}};

    # Never serve a file through a symlink that someone else owns, such as a
    # link to another account's wp-config.php. Every part of the path is
    # checked, the document root too: an account owns its document root and
    # could replace it with a link into another account's home.
    disable_symlinks if_not_owner;
    client_max_body_size {{.ClientMaxBodySize}};
{{- template "suspended" .}}
{{- if .Suspended}}

    # The website reached a limit its account set for it.
    default_type text/html;
    return 503 '{{template "unavailable-page"}}';
{{- end}}
{{- with .Hotlink}}

    # Hotlink protection: other websites may not embed these files.
    valid_referers {{.Referers}};
    set $rayxo_hotlink "";
    if ($uri ~* "\.(?:{{.Pattern}})$") {
        set $rayxo_hotlink $invalid_referer;
    }
    if ($rayxo_hotlink) {
        return {{if .RedirectTo}}302 "{{.RedirectTo}}"{{else}}403{{end}};
    }
{{- end}}
{{- if .ErrorPages}}

    # The website's own pages for the errors of Nginx itself; Apache shows
    # them for its own errors.
{{- range .ErrorPages}}
    error_page {{.NginxStatuses}} {{.URI}};
{{- end}}

    # Only ever shown as an error page: nothing else in the folder, not
    # even a script, is served from it.
    location ^~ /.errors/ {
        internal;
        try_files $uri =404;
    }
{{- end}}
{{- range .Redirects}}

    # Redirect {{.Path}}{{if .Wildcard}} and everything under it{{end}}.
    location ~ {{.Location}} {
{{- if .Wildcard}}
        if ($request_uri ~ "{{.RequestPattern}}") {
            return {{.Status}} "{{.Target}}$rayxo_rest{{.Query}}";
        }
{{- end}}
        return {{.Status}} "{{.Target}}{{.Query}}";
    }
{{- end}}

    # Apache's own files, and the usage Pure-FTPd keeps for an FTP quota.
    location ~ /\.(?:ht|ftpquota$) {
        deny all;
    }
{{- range .Protected}}

    # {{.Path}} and everything in it ask for a username and password.
    location ~ {{.Location}} {
        auth_basic "{{.Realm}}";
        auth_basic_user_file {{.File}};
{{- template "static" ($.Static "    ")}}
{{template "proxy" $}}
    }
{{- end}}
{{- if .CGI}}

    # CGI scripts always run in Apache, whatever their name ends in.
    location ~ ^/cgi-bin/ {
{{- template "proxy" .}}
    }
{{- end}}
{{- template "static" (.Static "")}}

    location / {
{{- template "proxy" .}}
    }

    location @apache {
{{- template "proxy" .}}
    }
{{- end}}
{{- /* Static files straight from disk, with the content types the site sets for some. */ -}}
{{define "static"}}

{{.Indent}}    # Static files straight from disk. Missing ones go to Apache, so rewrites
{{.Indent}}    # in .htaccess still work.
{{.Indent}}    location ~* \.(?:{{.Pattern}})$ {
{{- range .Types}}
{{$.Indent}}        location ~* \.{{.Extension}}$ {
{{$.Indent}}            types {}
{{$.Indent}}            default_type {{.Type}};
{{$.Indent}}            try_files $uri @apache;
{{$.Indent}}        }
{{- end}}
{{.Indent}}        try_files $uri @apache;
{{.Indent}}    }
{{- end}}
{{- /* Apache behind Nginx. X-Forwarded-Proto tells Apache (and PHP) whether the visitor uses HTTPS. */ -}}
{{define "proxy"}}
        proxy_pass http://{{.Backend}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        # Room for large response headers (big cookies, Link preloads), which
        # would otherwise end in a 502.
        proxy_buffer_size 32k;
        proxy_buffers 16 16k;
        proxy_busy_buffers_size 64k;
{{- end}}
